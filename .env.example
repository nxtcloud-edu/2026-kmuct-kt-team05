# ============================================================
#  KMU WAYFINDER — 환경변수 예시
#  실제 값은 .env.local 에 넣는다 (.env.local 은 git에 올라가지 않음)
# ============================================================

# --- UI 담당 영역 ---
# 1 이면 lib/client.ts 가 실제 API 대신 lib/mock.ts 의 목 데이터를 반환한다.
# 엔진 없이 UI를 개발/데모할 때 사용.
NEXT_PUBLIC_USE_MOCK=1

# --- 엔진 담당 영역 (UI는 사용하지 않음) ---
# LLM 키가 없어도 /api/route 는 정상 동작해야 한다. 내레이션/자연어 파싱만 비활성화된다.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
